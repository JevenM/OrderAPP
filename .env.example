# 复制本文件为 .env 后填写（本地开发用；部署到 GitHub Pages 时填到仓库 Settings → Secrets）
# Supabase 项目 → Settings → API
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# 进入应用的邀请码（自己随便定一个，两个人用同一个）
VITE_INVITE_CODE=520

# 进入「我的」管理页的独特口令（登录页不会显示该入口，可用 Secret 覆盖）
VITE_ADMIN_CODE=admin

# 可选：应用显示名称
VITE_APP_TITLE=What to have today?
